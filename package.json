{
  "name": "colormatic-keycloak-theme",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:login": "vite --config vite.login.config.ts",
    "dev:account": "vite --config vite.account.config.ts",
    "build": "bun run build:themes && keycloakify build",
    "build:login": "vite build --config vite.login.config.ts",
    "build:account": "vite build --config vite.account.config.ts",
    "build:themes": "bun run build:login && bun run build:account && node scripts/merge-account-login.mjs",
    "preview": "vite preview",
    "check": "bun run check:svelte && bun run check:types && bun run check:tailwind && bun run check:lint",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "check:types": "tsc -p tsconfig.check.json",
    "check:tailwind": "tailwindcss --input src/main.css --output /tmp/tailwind-check.css --minify",
    "check:lint": "eslint .",
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "storybook": "storybook dev --no-open -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@internationalized/date": "^3.10.1",
    "@keycloakify/svelte": "^0.2.9",
    "@lucide/svelte": "^0.515.0",
    "@storybook/addon-docs": "^10.3.4",
    "@storybook/addon-svelte-csf": "5.1.2",
    "@storybook/svelte-vite": "^10.3.4",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/eslint": "^9.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "bits-ui": "^2.15.5",
    "clsx": "^2.1.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-storybook": "^10.3.4",
    "eslint-plugin-svelte": "^3.17.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "keycloakify": "^11.15.3",
    "npm-check-updates": "^18.3.1",
    "path": "^0.12.7",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "storybook": "^10.3.4",
    "svelte": "^5.55.1",
    "svelte-check": "^4.4.5",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^1.0.0",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.3"
  },
  "dependencies": {
    "@keycloak/keycloak-admin-client": "^26.5.2",
    "@keycloakify/keycloak-account-ui": "^260502.0.2",
    "@keycloakify/keycloak-ui-shared": "^260502.0.0",
    "@patternfly/patternfly": "^5.4.2",
    "@patternfly/react-core": "^5.4.14",
    "@patternfly/react-icons": "^5.4.2",
    "@patternfly/react-table": "^5.4.16",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "bootstrap-icons": "^1.13.1",
    "i18next": "^25.7.3",
    "i18next-fetch-backend": "^7.0.0",
    "lodash-es": "^4.18.1",
    "mode-watcher": "^1.1.0",
    "oidc-spa": "^10.0.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.70.0",
    "react-i18next": "^16.5.1",
    "react-router-dom": "^6.30.3",
    "tailwindcss": "^4.2.2"
  }
}
