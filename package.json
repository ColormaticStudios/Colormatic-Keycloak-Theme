{
  "name": "colormatic-keycloak-theme",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "brace-expansion": "5.0.7",
    "flatted": "3.4.2",
    "lodash": "4.18.1",
    "picomatch": "4.0.5",
    "postcss": "8.5.19",
    "ws": "8.21.1",
    "yaml": "1.10.3"
  },
  "scripts": {
    "dev": "vite --mode login",
    "dev:login": "vite --mode login",
    "dev:account": "vite --mode account",
    "build": "vite build && keycloakify build",
    "build:theme": "vite build",
    "preview": "vite preview",
    "check": "bun run check:svelte && bun run check:types && bun run check:login-pages && bun run check:tests && bun run check:tailwind && bun run check:lint",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "check:types": "tsc -p tsconfig.check.json",
    "check:login-pages": "node scripts/check-login-page-coverage.mjs",
    "check:tests": "vitest run",
    "check:tailwind": "tailwindcss --input src/main.css --output /tmp/tailwind-check.css --minify",
    "check:lint": "eslint .",
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "storybook": "storybook dev --no-open -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@keycloakify/svelte": "^1.0.0",
    "@lucide/svelte": "^0.515.0",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/addon-svelte-csf": "5.1.2",
    "@storybook/svelte-vite": "^10.5.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@vitejs/plugin-react": "^6.0.3",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-svelte": "^3.20.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "keycloakify": "^11.15.11",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "storybook": "^10.5.2",
    "svelte": "^5.56.6",
    "svelte-check": "^4.7.3",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^1.0.0",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@keycloak/keycloak-admin-client": "^26.7.0",
    "@keycloakify/keycloak-account-ui": "^260700.0.0",
    "@keycloakify/keycloak-ui-shared": "^260700.0.0",
    "@patternfly/patternfly": "^5.4.2",
    "@patternfly/react-core": "^5.4.14",
    "@patternfly/react-icons": "^5.4.2",
    "@patternfly/react-styles": "^5.4.1",
    "@patternfly/react-table": "^5.4.16",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "bootstrap-icons": "^1.13.1",
    "i18next": "^25.10.10",
    "i18next-fetch-backend": "^7.0.0",
    "lodash-es": "^4.18.1",
    "mode-watcher": "^1.1.0",
    "oidc-spa": "^10.2.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.70.0",
    "react-i18next": "^16.6.6",
    "react-router-dom": "^6.30.4",
    "tsafe": "^1.8.12",
    "tailwindcss": "^4.3.3"
  }
}
