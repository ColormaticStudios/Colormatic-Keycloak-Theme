{
  "name": "colormatic-keycloak-theme",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build-keycloak-theme": "bun run build && keycloakify build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write '**/*.{ts,html,json,md,svelte,css}'",
    "lint": "yarn format && eslint . --fix",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@internationalized/date": "^3.10.1",
    "@keycloakify/svelte": "^0.2.7",
